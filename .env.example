APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-random-local-secret
DATABASE_PATH=data/technology_news.db
TIME_ZONE=Asia/Karachi
COLLECTION_INTERVAL_HOURS=3
DIGEST_HOUR=8
MAX_DIGEST_ARTICLES=10
MIN_DIGEST_SCORE=50

# Optional API-based news discovery (RSS/Google News feeds work without this key).
# Create a NewsAPI key at https://newsapi.org/ and paste it here to add API-based discovery.
NEWS_API_KEY=
NEWS_API_QUERY=artificial intelligence OR technology OR cybersecurity OR robotics OR cloud computing OR semiconductors
NEWS_API_LANGUAGE=en
NEWS_API_PAGE_SIZE=100

# Optional AI summaries. Configure a provider account and billing before enabling.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_RUN=50
AI_MAX_INPUT_CHARS=4500

# Optional email delivery. Set EMAIL_ENABLED=true only after SMTP testing.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=
